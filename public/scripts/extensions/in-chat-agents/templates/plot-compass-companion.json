{
  "id": "tpl-plot-compass-companion",
  "name": "Plot Compass",
  "description": "Combine global, character-card and chat objectives, each with its own on/off switch, to co-direct the story",
  "icon": "fa-compass",
  "category": "companion",
  "subcategory": "story-notes",
  "tags": [
    "plot",
    "objective",
    "planning"
  ],
  "version": 2,
  "author": "Neconyan",
  "prompt": "You are the user's co-director, helping the story move with purpose while leaving room for surprise and choice. [Plot Compass Objective], when present, is the user's desired direction, not a guaranteed outcome or a script.\n\nRead the recent scene, character motivations, established facts and previous notes. Track what has changed and what remains unresolved. Propose developments that follow naturally from the current situation and the objective, preserving continuity, pacing, tone and the characters' independent motivations. Distinguish established facts from speculation.\n\nGive concise, actionable planning notes in these sections:\n\n**Direction:** the objective in your own words, or the story's apparent momentum if none is set.\n**Where we are:** the most important progress, tension or open question in the current scene.\n**Possible developments:** two or three distinct, plausible ways the scene could move, including consequences or obstacles. Offer alternatives, not a fixed sequence or a rushed ending.\n**Next move:** one concrete suggestion for the assistant to bring into the next response, such as a character choice, reaction, complication or sensory detail, and why it matters.\n\nProtect the user's agency: leave their character's thoughts, feelings, actions and dialogue to them, and give planning notes rather than writing the next reply. If the scene or objective is missing, say what is unknown and suggest a useful starting direction without pretending events have happened. Adapt the detail to the context and avoid padding or repeating earlier notes.",
  "phase": "post",
  "execution": "companion",
  "companion": {
    "trigger": "auto",
    "displayMode": "panel",
    "format": "markdown",
    "rawPrompt": true,
    "inlinePhase": "",
    "contextMessages": 10,
    "includeCharacterCard": true,
    "includePersona": true,
    "includeWorldInfo": true,
    "includeAuthorsNote": true,
    "includeSystemPrompt": true,
    "includeHistory": true,
    "historyDepth": 1,
    "feedback": {
      "enabled": true,
      "depth": 1
    },
    "batch": false,
    "maxTokens": 64000,
    "chatHistoryPlacement": "block"
  },
  "injection": {
    "position": 0,
    "depth": 4,
    "role": 0,
    "order": 100,
    "scan": false
  },
  "postProcess": {
    "enabled": false,
    "type": "regex",
    "regexFind": "",
    "regexReplace": "",
    "regexFlags": "g",
    "appendText": "",
    "extractPattern": "",
    "extractVariable": ""
  },
  "enabled": false,
  "conditions": {
    "triggerKeywords": [],
    "triggerProbability": 100,
    "generationTypes": [
      "normal",
      "continue"
    ]
  },

{
  "id": "tpl-clothing-tracker-companion",
  "name": "Clothing Tracker",
  "description": "Tracks what your persona and the characters in the current scene are wearing, and carries outfits forward between replies",
  "icon": "fa-tags",
  "category": "companion",
  "subcategory": "stats-visuals",
  "tags": [
    "clothing",
    "outfits",
    "continuity",
    "tracker"
  ],
  "version": 1,
  "author": "Neconyan",
  "prompt": "Track what each character is wearing at the end of the latest reply. List {{user}} first if present, then each identifiable character still in the current scene. Leave out anyone who has left, is off-screen, or is only mentioned. Use the story's names or an established role for an unnamed character.\n\nRead the latest reply and recent scene first. Use your previous notes to carry forward clothing that is still being worn, including items the latest reply leaves unmentioned. Update only details established in the story: changes of layers, garments put on or taken off, footwear, worn accessories, and visible changes such as a soaked coat. The current scene takes precedence over previous notes. Use the persona and character cards as initial evidence only when their clothing descriptions apply to the scene. Leave out held or stored items.\n\nWrite one short line per wearer in plain text. Separate garments and accessories with semicolons. Use / in place of | inside fields. Use Not established for a present character whose outfit is unknown and No clothing only when the story explicitly establishes that. When no outfit information is established for anyone present, or there is nobody in the scene, return tracker-none.\n\nFormat (use the scene's actual wearers and outfits):\nclothing-start\noutfit|{{user}}|Rain-darkened navy coat; grey trousers; leather boots\noutfit|Mira|Cream jumper with rolled sleeves; brass watch\noutfit|Night porter|Not established\nclothing-end",
  "phase": "post",
  "execution": "companion",
  "companion": {
    "trigger": "auto",
    "displayMode": "panel",
    "format": "html",
    "rawPrompt": true,
    "contextMessages": 10,
    "includeCharacterCard": true,
    "includePersona": true,
    "includeWorldInfo": false,
    "includeAuthorsNote": false,
    "includeSystemPrompt": false,
    "includeHistory": true,
    "historyDepth": 1,
    "feedback": {
      "enabled": false,
      "depth": 1
    },
    "batch": false,
    "maxTokens": 64000,
    "chatHistoryPlacement": "source"
  },
  "regexScripts": [
    {

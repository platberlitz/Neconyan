{
  "id": "tpl-dice-roller-companion",
  "name": "Dice Roller",
  "description": "Roll a d20 or another die for what you attempt. The roll lands in the chat as your message, and the next reply treats the result as settled fact. It runs locally in its panel or note, with no extra model request.",
  "icon": "fa-dice-d20",
  "category": "companion",
  "subcategory": "story-notes",
  "tags": [
    "dice",
    "roll",
    "skill check",
    "d20",
    "chance"
  ],
  "version": 1,
  "author": "Neconyan",

      "replaceString": "<details open style=\"margin:14px 0;border-radius:16px;overflow:hidden;border:1px solid rgba(246,193,119,0.38);background:linear-gradient(160deg,#261c3d 0%,#1b1731 55%,#2b1c35 100%);box-shadow:0 12px 28px rgba(0,0,0,0.30)\"><summary style=\"display:flex;align-items:center;gap:8px;padding:11px 14px;cursor:pointer;list-style:none;background:linear-gradient(90deg,rgba(246,193,119,0.18),rgba(255,143,177,0.10));border-bottom:1px solid rgba(246,193,119,0.24)\"><span style=\"font-size:15px\">🧭</span><span style=\"font-family:Georgia,serif;font-style:italic;font-size:14px;letter-spacing:0.3px;color:#f6d9a8\">What will you do?</span><span style=\"margin-left:auto;font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:#bfb3d9\">choose ▾</span></summary><div style=\"padding:8px 11px 11px;font-size:13px;color:#ece6f7\"><div class=\"pura-choice\" style=\"display:flex;align-items:flex-start;gap:10px;margin:6px 0;padding:9px 11px;border-radius:12px;background:linear-gradient(90deg,rgba(255,143,177,0.16),rgba(255,255,255,0.025));border:1px solid rgba(255,143,177,0.30)\"><span style=\"flex:0 0 24px;width:24px;height:24px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;background:radial-gradient(circle at 32% 28%,rgba(255,255,255,0.75),#ff8fb1 62%);color:#221a35;font-weight:700;font-size:12px;font-family:Georgia,serif;box-shadow:0 2px 6px rgba(255,143,177,0.35)\">$1</span><span style=\"flex:1;min-width:0;line-height:1.5;padding-top:2px\">$2</span></div><div class=\"pura-choice\" style=\"display:flex;align-items:flex-start;gap:10px;margin:6px 0;padding:9px 11px;border-radius:12px;background:linear-gradient(90deg,rgba(246,193,119,0.16),rgba(255,255,255,0.025));border:1px solid rgba(246,193,119,0.30)\"><span style=\"flex:0 0 24px;width:24px;height:24px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;background:radial-gradient(circle at 32% 28%,rgba(255,255,255,0.75),#f6c177 62%);color:#22